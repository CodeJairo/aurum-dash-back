# AurumDash Backend Configuration
PORT=3000
NODE_ENV=production

# Database Connection (Railway PostgreSQL or Local Docker)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# JWT Secret
JWT_SECRET="generate_a_secure_random_key_here"
JWT_EXPIRES_IN="7d"

# Frontend URL (CORS origin)
FRONTEND_URL="https://tu-frontend-en-railway.up.railway.app"

# S3 Storage Configuration (Producción: AWS S3 | Local/Alternativo: MinIO / Cloudflare R2)
# Para AWS S3 oficial, dejar S3_ENDPOINT comentado/vacío y S3_FORCE_PATH_STYLE en false:
# S3_ENDPOINT=""
S3_BUCKET="atlas-capital-docs-629126494223"
S3_REGION="us-east-2"
S3_ACCESS_KEY_ID="tu_access_key_id"
S3_SECRET_ACCESS_KEY="tu_secret_access_key"
S3_FORCE_PATH_STYLE="false"

# Credenciales de Usuarios Administradores (Seed)
DANIEL_PASSWORD="password123"
ANDRES_PASSWORD="password123"
