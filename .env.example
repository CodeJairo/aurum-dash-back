# AurumDash Backend Configuration
PORT=3000
NODE_ENV=production

# Database Connection (Railway PostgreSQL or Local Docker)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# JWT Secret
JWT_SECRET="generate_a_secure_random_key_here"
JWT_EXPIRES_IN="7d"

# Frontend URL (CORS origin)
FRONTEND_URL="https://tu-frontend-en-railway.up.railway.app"
