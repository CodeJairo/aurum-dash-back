generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VIEWER
  PARTNER
  BAREQUERO_OPERATOR
}

enum BatchStatus {
  OPEN
  CLOSED
}

enum PricingMode {
  PER_FINE_GRAM
  PER_GROSS_GRAM
}

enum PurchaseType {
  ACCOUNTING
  FORMAL
}

enum FormalizerStatus {
  AVAILABLE
  USED
}

enum PaymentAccount {
  CASH
  BANK
  MIXED
  INTERNAL_TRANSFER
}

enum ExpenseStatus {
  PENDING
  LIQUIDATED
}

enum CapitalMovementType {
  PURCHASE_PAYMENT
  BATCH_SALE_INCOME
  CAPITAL_INJECTION
  CAPITAL_WITHDRAWAL
  MANUAL_ADJUSTMENT
  INTERNAL_TRANSFER
  EXPENSE_PAYMENT
  PARTNER_PROFIT_PAYOUT
}

enum ExpenseCategory {
  FOUR_PER_THOUSAND
  OPERATIONAL
  TRANSPORT
  MELTING_LAB
  COMMISSION
  OTHER
}

enum MaterialType {
  GOLD
  PLATINUM
}

model Company {
  id                 String       @id @default(uuid())
  name               String
  nit                String?
  slug               String       @unique
  phone              String?
  address            String?
  city               String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users              User[]
  systemSetting      SystemSetting?
  batches            Batch[]
  purchases          Purchase[]
  formalizers        Formalizer[]
  barequeroDocuments BarequeroDocument[]
  capitalMovements   CapitalMovement[]
  sales              Sale[]
  expenses           Expense[]
  monthlySettlements MonthlySettlement[]

  @@map("companies")
}

model User {
  id                 String       @id @default(uuid())
  companyId          String?
  company            Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  username           String?      @unique
  email              String?      @unique
  name               String
  password           String
  role               Role         @default(PARTNER)
  profitSharePercent Decimal      @default(50.00) @db.Decimal(5, 2)
  isActive           Boolean      @default(true)
  tokenVersion       Int          @default(0)
  lastLogin          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  purchases          Purchase[]
  sales              Sale[]
  expenses           Expense[]
  batchesCreated     Batch[]      @relation("BatchCreator")
  monthlySettlementsCreated MonthlySettlement[] @relation("MonthlySettlementCreator")
  refreshSessions    RefreshSession[]

  @@index([companyId])
  @@map("users")
}

model Batch {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  status             BatchStatus  @default(OPEN)
  material           MaterialType @default(GOLD)

  // Consolidaciones automáticas del lote
  totalGrossGrams    Decimal      @default(0.0000) @db.Decimal(12, 4)
  totalFineGrams     Decimal      @default(0.0000) @db.Decimal(12, 4)
  totalInvestment    Decimal      @default(0.00) @db.Decimal(14, 2)

  // Valores de compra vs. refundición para venta
  initialGrossGrams  Decimal?     @db.Decimal(12, 4)
  initialFineGrams   Decimal?     @db.Decimal(12, 4)
  meltedGrossGrams   Decimal?     @db.Decimal(12, 4)
  meltedFineGrams    Decimal?     @db.Decimal(12, 4)

  // Métricas derivadas / Liquidación
  averageCostPerFineGram Decimal  @default(0.00) @db.Decimal(14, 2)
  totalSales         Decimal      @default(0.00) @db.Decimal(14, 2)
  totalExpenses      Decimal      @default(0.00) @db.Decimal(14, 2)
  netProfit          Decimal      @default(0.00) @db.Decimal(14, 2)
  closedAt           DateTime?

  // Datos de venta y formalización
  formalizerCount             Int?
  formalizationCostPerPerson  Decimal?     @default(170000.00) @db.Decimal(14, 2)
  formalizationTotalCost      Decimal?     @default(0.00) @db.Decimal(14, 2)
  fourPerThousandAmount       Decimal?     @default(0.00) @db.Decimal(14, 2)
  otherExpensesAmount         Decimal?     @default(0.00) @db.Decimal(14, 2)
  otherExpensesConcept        String?
  grossSaleAmount             Decimal?     @default(0.00) @db.Decimal(14, 2)
  netSaleAmount               Decimal?     @default(0.00) @db.Decimal(14, 2)
  salePricePerGram            Decimal?     @db.Decimal(14, 2)
  soldAt                      DateTime?

  createdById        String?
  createdBy          User?        @relation("BatchCreator", fields: [createdById], references: [id])

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  purchases          Purchase[]   @relation("BatchPurchases")
  formalizedPurchases Purchase[]  @relation("BatchFormalizations")
  sales              Sale[]
  expenses           Expense[]
  settlements        Settlement[]
  formalizers        Formalizer[]

  monthlySettlementId String?
  monthlySettlement   MonthlySettlement? @relation("MonthlySettlementBatches", fields: [monthlySettlementId], references: [id], onDelete: SetNull)

  @@unique([companyId, code])
  @@index([companyId])
  @@map("batches")
}

model Purchase {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         PurchaseType @default(ACCOUNTING)
  material     MaterialType @default(GOLD)
  consecutive  String?

  // Datos del Barequero / Proveedor
  supplier     String?
  vendorDoc    String?
  vendorAddress String?
  vendorPhone  String?
  vendorCity   String?
  vendorCountry String?     @default("Colombia")

  // Datos del Receptor (Snapshot en la transacción)
  recipientName    String?
  recipientDoc     String?
  recipientAddress String?

  description  String?

  grossGrams   Decimal      @db.Decimal(12, 4)
  purity       Decimal?     @db.Decimal(10, 6)
  purityRaw    Decimal?     @db.Decimal(8, 3) // Ej. 750 o 993.96 para facilitar referencia
  fineGrams    Decimal      @db.Decimal(14, 6)
  pricePerGram Decimal      @db.Decimal(14, 2)
  pricingMode  PricingMode  @default(PER_FINE_GRAM)
  totalCost    Decimal      @db.Decimal(14, 2)

  purchaseDate DateTime     @default(now())
  deliveryDate DateTime?    @default(now())

  batchId           String?
  batch             Batch?       @relation("BatchPurchases", fields: [batchId], references: [id], onDelete: SetNull)

  formalizedBatchId String?
  formalizedBatch   Batch?       @relation("BatchFormalizations", fields: [formalizedBatchId], references: [id], onDelete: SetNull)

  // Soporte de Recepción Firmada
  isSigned          Boolean   @default(false)
  signedReceiptUrl  String?
  signedReceiptKey  String?
  signedReceiptName String?
  signedAt          DateTime?

  // Sincronización Siigo Nube (Recibos de Pago)
  siigoReceiptId     String?
  siigoReceiptNumber String?
  siigoSyncedAt      DateTime?

  // Foto del Barequero al momento de la compra
  vendorPhotoUrl     String?
  vendorPhotoKey     String?

  // Forma y origen de pago de la compra
  paymentMethod      PaymentAccount @default(CASH)
  cashAmount         Decimal?       @db.Decimal(14, 2)
  bankAmount         Decimal?       @db.Decimal(14, 2)

  // Control de formalización histórica (para compras importadas de Siigo con 0g)
  isFormalizedHistorically Boolean   @default(false)

  createdById  String?
  createdBy    User?        @relation(fields: [createdById], references: [id])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([companyId, consecutive, type])
  @@index([companyId])
  @@map("purchases")
}

model SystemSetting {
  id                  String   @id @default(uuid())
  companyId           String   @unique
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  legalName           String   @default("DANIEL CAMILO HERRERA RENTERIA")
  document            String   @default("1.078.000.069")
  address             String   @default("CR 8 CL 30 8 07")
  phone               String?  @default("")
  city                String?  @default("Quibdó")
  country             String?  @default("Colombia")
  consecutivePrefix   String   @default("DH-")
  lastConsecutiveNum  Int      @default(0)
  lastPurchaseNum     Int      @default(0)
  currentCapital      Decimal  @default(0.00) @db.Decimal(14, 2)
  cashCapital         Decimal  @default(0.00) @db.Decimal(14, 2)
  bankCapital         Decimal  @default(0.00) @db.Decimal(14, 2)

  // Integración Siigo Nube por Empresa
  siigoActive         Boolean  @default(false)
  siigoApiUrl         String?  @default("https://api.siigo.com")
  siigoUsername       String?
  siigoAccessKey      String?
  siigoPartnerId      String?  @default("AtlasCapital")
  siigoDebitAccount   String?  @default("13309595")
  siigoCreditAccount  String?  @default("11050501")
  siigoRpDocumentId   Int?     @default(31163)
  siigoCashPaymentId  Int?     @default(4375)

  updatedAt           DateTime @updatedAt

  @@map("system_settings")
}

model Formalizer {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  document      String
  address       String
  phone         String?
  city          String           @default("Quibdó-Chocó")
  country       String           @default("Colombia")
  status        FormalizerStatus @default(AVAILABLE)

  // Datos específicos para Formulario Único de Vinculación
  firstName          String?
  firstLastName      String?
  secondLastName     String?
  idType             String?          @default("CC")
  nationality        String?          @default("Colombiana")
  docIssueDate       DateTime?
  docIssuePlace      String?
  miningMunicipality String?
  miningDepartment   String?          @default("Chocó")
  email              String?
  ciiuCode           String?          @default("0722")
  declaresRent       Boolean?         @default(false)
  monthlyIncome      Decimal?         @db.Decimal(14, 2)
  incomeConcept      String?
  monthlyExpenses    Decimal?         @db.Decimal(14, 2)
  expenseConcept     String?
  isPep              Boolean?         @default(false)

  // Control documental de vinculación
  hasVinculacionForm Boolean          @default(false)
  vinculacionFormUrl String?
  vinculacionFormKey String?
  vinculatedAt       DateTime?
  vinculacionData    Json?

  usedInBatchId String?
  usedInBatch   Batch?           @relation(fields: [usedInBatchId], references: [id], onDelete: SetNull)
  usedAt        DateTime?

  documents     BarequeroDocument[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([companyId, document])
  @@index([companyId])
  @@map("formalizers")
}

model BarequeroDocument {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  formalizerId String
  formalizer   Formalizer @relation(fields: [formalizerId], references: [id], onDelete: Cascade)
  name         String
  category     String     @default("OTRO") // CEDULA_FRONTAL, CEDULA_POSTERIOR, RUT, CERTIFICADO_BANCARIO, FOTO_BAREQUERO, OTRO
  period       String?    // Ej: "2026-11" o "Noviembre 2026" para carpetas mensuales
  fileKey      String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime   @default(now())

  @@index([companyId])
  @@map("barequero_documents")
}

model CapitalMovement {
  id            String              @id @default(uuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          CapitalMovementType
  amount        Decimal             @db.Decimal(14, 2)
  balanceBefore Decimal             @db.Decimal(14, 2)
  balanceAfter  Decimal             @db.Decimal(14, 2)
  description   String
  referenceId   String?
  receiptUrl    String?
  receiptKey    String?
  account       PaymentAccount      @default(CASH)
  sourceAccount PaymentAccount?
  targetAccount PaymentAccount?
  createdAt     DateTime            @default(now())

  @@index([companyId])
  @@map("capital_movements")
}

model Sale {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     String?
  description  String?

  grossGrams   Decimal?     @db.Decimal(12, 4)
  fineGrams    Decimal?     @db.Decimal(12, 4)
  pricePerGram Decimal?     @db.Decimal(14, 2)
  totalAmount  Decimal      @db.Decimal(14, 2)
  destinationAccount PaymentAccount @default(BANK)

  saleDate     DateTime     @default(now())

  batchId      String?
  batch        Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdById  String?
  createdBy    User?        @relation(fields: [createdById], references: [id])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
  @@map("sales")
}

model Expense {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description  String
  category     ExpenseCategory @default(OPERATIONAL)
  amount       Decimal         @db.Decimal(14, 2)
  expenseDate  DateTime        @default(now())

  batchId      String?
  batch        Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Información de pago y comprobante
  paymentAccount PaymentAccount @default(CASH)
  receiptUrl     String?
  receiptKey     String?
  status         ExpenseStatus  @default(PENDING)

  monthlySettlementId String?
  monthlySettlement   MonthlySettlement? @relation("MonthlySettlementPeriodExpenses", fields: [monthlySettlementId], references: [id], onDelete: SetNull)

  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id])

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([companyId])
  @@map("expenses")
}

model Settlement {
  id             String       @id @default(uuid())
  batchId        String
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)

  totalSales     Decimal      @db.Decimal(14, 2)
  totalCost      Decimal      @db.Decimal(14, 2)
  totalExpenses  Decimal      @db.Decimal(14, 2)
  netProfit      Decimal      @db.Decimal(14, 2)

  // Desglose por socio
  clientProfit   Decimal      @db.Decimal(14, 2)
  partnerProfit  Decimal      @db.Decimal(14, 2)
  clientPercent  Decimal      @db.Decimal(5, 2)
  partnerPercent Decimal      @db.Decimal(5, 2)

  settlementDate DateTime     @default(now())
  notes          String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("settlements")
}

model MonthlySettlement {
  id                    String                     @id @default(uuid())
  companyId             String
  company               Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                  String
  startDate             DateTime
  endDate               DateTime
  settlementDate        DateTime                   @default(now())

  // Consolidación Comercial de los Lotes cerrados en el periodo
  totalGrossSales       Decimal                    @default(0.00) @db.Decimal(14, 2)
  totalDirectExpenses   Decimal                    @default(0.00) @db.Decimal(14, 2)
  totalNetSales         Decimal                    @default(0.00) @db.Decimal(14, 2)
  totalInvestmentCost   Decimal                    @default(0.00) @db.Decimal(14, 2)
  commercialProfit      Decimal                    @default(0.00) @db.Decimal(14, 2)

  // Gastos Generales ingresados por el usuario
  generalExpensesTotal  Decimal                    @default(0.00) @db.Decimal(14, 2)

  // Utilidad Neta Real a Distribuir
  netProfit             Decimal                    @default(0.00) @db.Decimal(14, 2)

  // Repartición Socios
  partner1Name          String                     @default("Daniel")
  partner1Percent       Decimal                    @default(50.00) @db.Decimal(5, 2)
  partner1Amount        Decimal                    @default(0.00) @db.Decimal(14, 2)

  partner2Name          String                     @default("Andrés")
  partner2Percent       Decimal                    @default(50.00) @db.Decimal(5, 2)
  partner2Amount        Decimal                    @default(0.00) @db.Decimal(14, 2)

  // Salida de utilidades repartidas a socios
  payoutAccount         PaymentAccount             @default(BANK)
  payoutCashAmount      Decimal?                   @db.Decimal(14, 2)
  payoutBankAmount      Decimal?                   @db.Decimal(14, 2)

  notes                 String?

  createdById           String?
  createdBy             User?                      @relation("MonthlySettlementCreator", fields: [createdById], references: [id])

  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  expenses              MonthlySettlementExpense[]
  registeredExpenses    Expense[]                  @relation("MonthlySettlementPeriodExpenses")
  batches               Batch[]                    @relation("MonthlySettlementBatches")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("monthly_settlements")
}

model MonthlySettlementExpense {
  id                  String            @id @default(uuid())
  monthlySettlementId String
  monthlySettlement   MonthlySettlement @relation(fields: [monthlySettlementId], references: [id], onDelete: Cascade)
  concept             String
  amount              Decimal           @db.Decimal(14, 2)
  createdAt           DateTime          @default(now())

  @@map("monthly_settlement_expenses")
}

model RefreshSession {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti           String    @unique
  tokenHash     String
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?   // 'ROTATED', 'LOGOUT', 'USER_REVOKED', 'SUSPICIOUS_REUSE'
  replacedByJti String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([jti])
  @@map("refresh_sessions")
}
